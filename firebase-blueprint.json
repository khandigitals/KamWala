  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Authenticated user workspace profile and wallet/settings state."
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Bookings owned by the authenticated user."
    },
    "/users/{userId}/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Verified worker roster in user's marketplace workspace."
    },
    "/users/{userId}/bigJobs/{jobId}": {
      "schema": { "$ref": "#/entities/BigJob" },
      "description": "Custom quote Big Jobs owned by the user."
    },
    "/users/{userId}/bids/{bidId}": {
      "schema": { "$ref": "#/entities/Bid" },
      "description": "Worker bids linked to BigJobs."
    },
    "/users/{userId}/b2bLeads/{leadId}": {
      "schema": { "$ref": "#/entities/B2bLead" },
      "description": "Corporate B2B contract leads."
    },
    "/users/{userId}/topUpRequests/{requestId}": {
      "schema": { "$ref": "#/entities/TopUpRequest" },
      "description": "Worker wallet recharge requests."
    },
    "/users/{userId}/toolLoans/{loanId}": {
      "schema": { "$ref": "#/entities/ToolLoan" },
      "description": "Tool financing Asaan Qist loans."
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Order-scoped chat messages."
    },
    "/users/{userId}/activePlans/{planId}": {
      "schema": { "$ref": "#/entities/ActivePlan" },
      "description": "Activated monthly care plans."
    },
    "/marketplaceProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/MarketplaceProfile" },
      "description": "Registered customer, karegar worker, and admin marketplace profiles."
    },
    "/marketplaceOrders/{orderId}": {
      "schema": { "$ref": "#/entities/MarketplaceOrder" },
      "description": "Shared cross-account service bookings picked by verified workers."
    },
    "/marketplaceOrders/{orderId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/MarketplaceChatMessage" },
      "description": "Shared real-time chat between customer and assigned worker for an order."
    },
    "/marketplaceTopUps/{requestId}": {
      "schema": { "$ref": "#/entities/MarketplaceTopUp" },
      "description": "Shared worker prepaid wallet top-up requests awaiting admin approval."
    },
    "/marketplaceToolLoans/{loanId}": {
      "schema": { "$ref": "#/entities/MarketplaceToolLoan" },
      "description": "Shared worker tool qist financing applications."
    },
    "/marketplaceBigJobs/{jobId}": {
      "schema": { "$ref": "#/entities/MarketplaceBigJob" },
      "description": "Shared open project requests for worker bids."
    },
    "/marketplaceBigJobs/{jobId}/bids/{bidId}": {
      "schema": { "$ref": "#/entities/MarketplaceBid" },
      "description": "Bids submitted by approved workers on a shared Big Job."
    },
    "/marketplaceB2b/{leadId}": {
      "schema": { "$ref": "#/entities/MarketplaceB2b" },
      "description": "Shared corporate B2B inquiries visible to admin."
    },
    "/marketplaceConfig/{configId}": {
      "schema": { "$ref": "#/entities/MarketplaceConfig" },
      "description": "Global marketplace payment account and commission settings."
    },
    "/adminLedger/{entryId}": {
      "schema": { "$ref": "#/entities/AdminLedgerEntry" },
      "description": "Persistent itemized admin earnings and payout withdrawal ledger."
    }
  }
}
