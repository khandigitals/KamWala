{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Authenticated user profile, app preferences, worker wallet, and command metrics.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the workspace owner." },
        "displayName": { "type": "string", "description": "Google account display name." },
        "email": { "type": "string", "description": "Google account email address." },
        "lang": { "type": "string", "enum": ["en", "ur"], "description": "UI language preference." },
        "brand": { "type": "string", "description": "Brand display name." },
        "city": { "type": "string", "description": "Active service city." },
        "whatsapp": { "type": "string", "description": "Admin WhatsApp dispatch number." },
        "payAccount": { "type": "string", "description": "JazzCash / Easypaisa recharge account details." },
        "leadFee": { "type": "integer", "description": "Lead fee in PKR deducted per accepted job." },
        "staffPin": { "type": "string", "description": "4-6 digit PIN gating staff tabs." },
        "liveCustomerMode": { "type": "boolean", "description": "Whether demo data and staff tabs are hidden." },
        "customerCredit": { "type": "integer", "description": "Referral credit wallet balance in PKR." },
        "walletBalance": { "type": "integer", "description": "Worker prepaid lead wallet balance in PKR." },
        "appRevenue": { "type": "integer", "description": "Accumulated platform revenue in PKR." },
        "workerOnline": { "type": "boolean", "description": "Worker dispatch online status." },
        "workerStrikes": { "type": "integer", "description": "Worker quality strike count (0-3)." },
        "usedFirstPromo": { "type": "boolean", "description": "Whether FIRST200 promo has been redeemed." },
        "activeWorkerName": { "type": "string", "description": "Currently selected Partner Pro name." },
        "isSeeded": { "type": "boolean", "description": "Whether initial sample records have been seeded." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when last updated." }
      },
      "required": [
        "userId", "displayName", "lang", "brand", "city", "whatsapp", "payAccount",
        "leadFee", "staffPin", "liveCustomerMode", "customerCredit", "walletBalance",
        "appRevenue", "workerOnline", "workerStrikes", "usedFirstPromo", "activeWorkerName",
        "isSeeded", "createdAt", "updatedAt"
      ]
    },
