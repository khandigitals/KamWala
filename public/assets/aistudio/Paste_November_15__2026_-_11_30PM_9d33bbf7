<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#059669" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>KaamWala — Verified Home Services</title>
  <style>
    :root {
      --primary: #059669;
      --primary-dark: #064e3b;
      --primary-light: #ecfdf5;
      --dark: #0f172a;
      --muted: #64748b;
      --bg: #f1f5f9;
      --border: #e2e8f0;
      --danger: #dc2626;
      --shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.08);
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background: #cbd5e1;
      color: var(--dark);
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }
    .phone-shell {
      width: 100%;
      max-width: 440px;
      min-height: 100vh;
      background: var(--bg);
      position: relative;
      padding-bottom: 88px;
      box-shadow: 0 20px 60px rgba(15, 23, 42, 0.3);
      overflow-x: hidden;
    }
    .hero {
      background: linear-gradient(155deg, rgba(6,78,59,0.95), rgba(15,23,42,0.93)),
                  url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80') center/cover;
      color: #fff;
      padding: 14px 16px 20px;
      border-bottom-left-radius: 26px;
      border-bottom-right-radius: 26px;
    }
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      gap: 6px;
    }
    .brand-wrap { display: flex; align-items: center; gap: 9px; cursor: pointer; }
    .brand-logo {
      width: 36px; height: 36px; border-radius: 12px;
      background: linear-gradient(135deg, #34d399, #059669);
      display: flex; align-items: center; justify-content: center;
      font-size: 19px; user-select: none;
    }
    .brand-name { font-size: 17px; font-weight: 800; }
    .brand-tag { font-size: 10px; color: #a7f3d0; display: block; font-weight: 600; }
    .top-actions { display: flex; gap: 5px; align-items: center; }
    .pill-btn {
      background: rgba(255,255,255,0.16);
      border: 1px solid rgba(255,255,255,0.24);
      color: #fff; padding: 5px 10px; border-radius: 20px;
      font-size: 11px; font-weight: 700; cursor: pointer;
    }
    .icon-btn {
      width: 31px; height: 31px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.22);
      background: rgba(255,255,255,0.16);
      color: #fff; font-size: 14px; cursor: pointer;
    }
    .hero-title { font-size: 19px; font-weight: 800; line-height: 1.28; margin-bottom: 6px; }
    .hero-stats { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
    .hero-stat {
      font-size: 10.5px; font-weight: 700; color: #ecfdf5;
      background: rgba(255,255,255,0.13); padding: 3px 8px; border-radius: 8px;
    }
    .search-box {
      display: flex; align-items: center; gap: 8px;
      background: #fff; border-radius: 14px; padding: 10px 12px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.16);
    }
    .search-box input {
      border: none; outline: none; width: 100%;
      font-size: 13px; color: var(--dark); background: transparent; padding: 0;
    }
    .ai-box {
      margin: 11px 16px 0; background: #ecfdf5;
      border: 1.5px solid #6ee7b7; border-radius: 14px; padding: 11px 12px;
    }
    .reminder-bar {
      margin: 11px 16px 0; background: #fffbeb;
      border: 1px solid #fcd34d; border-radius: 14px; padding: 9px 12px;
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
    }
    .promo-strip {
      margin: 10px 16px 0; background: linear-gradient(135deg, #065f46, #047857);
      color: #fff; border-radius: 16px; padding: 11px 14px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .promo-code {
      background: #fef3c7; color: #92400e; font-weight: 800; font-size: 11px;
      padding: 5px 9px; border-radius: 8px; border: 1px dashed #d97706; cursor: pointer;
    }
    .cat-row { display: flex; gap: 7px; overflow-x: auto; padding: 12px 16px 2px; scrollbar-width: none; }
    .cat-row::-webkit-scrollbar { display: none; }
    .cat-chip {
      flex-shrink: 0; background: #fff; border: 1.5px solid var(--border);
      padding: 7px 12px; border-radius: 22px; font-size: 11.5px;
      font-weight: 700; color: #475569; cursor: pointer;
    }
    .cat-chip.active { background: var(--dark); border-color: var(--dark); color: #fff; }
    .cat-chip.pink-active { background: #be185d; border-color: #be185d; color: #fff; }

    .section { padding: 13px 16px 4px; }
    .sec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .sec-title { font-size: 15px; font-weight: 800; color: var(--dark); }
    .sec-link { font-size: 11px; font-weight: 700; color: var(--primary); cursor: pointer; }

    .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 11px; }
    .svc-card {
      background: #fff; border-radius: 16px; overflow: hidden;
      border: 1px solid var(--border); cursor: pointer; box-shadow: var(--shadow);
    }
    .svc-img-wrap { position: relative; height: 102px; background: #cbd5e1; overflow: hidden; }
    .svc-img-wrap::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(15,23,42,0.65) 0%, transparent 60%);
    }
    .svc-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .svc-badge {
      position: absolute; top: 7px; left: 7px; z-index: 2;
      background: rgba(15,23,42,0.78); color: #fff;
      font-size: 9.5px; font-weight: 700; padding: 3px 7px; border-radius: 7px;
    }
    .svc-eta {
      position: absolute; bottom: 6px; right: 6px; z-index: 2;
      background: #ecfdf5; color: #065f46; font-size: 9.5px;
      font-weight: 800; padding: 2px 6px; border-radius: 6px;
    }
    .svc-body { padding: 9px 10px 10px; }
    .svc-name { font-size: 13px; font-weight: 800; color: var(--dark); margin-bottom: 2px; }
    .svc-desc {
      font-size: 10.5px; color: var(--muted); margin-bottom: 8px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .svc-foot { display: flex; justify-content: space-between; align-items: center; }
    .svc-price { font-size: 12px; font-weight: 800; color: var(--primary); }
    .svc-btn {
      font-size: 10.5px; font-weight: 800; color: #fff;
      background: var(--primary); padding: 4px 10px; border-radius: 8px;
    }

    .dual-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .action-tile {
      border-radius: 16px; padding: 12px; color: #fff; cursor: pointer;
      display: flex; flex-direction: column; justify-content: space-between; min-height: 90px;
    }
    .h-scroll { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
    .h-scroll::-webkit-scrollbar { display: none; }
    .plan-card {
      flex-shrink: 0; width: 205px; background: linear-gradient(145deg,#0f172a,#1e293b);
      color: #fff; border-radius: 16px; padding: 12px;
    }
    .pro-card {
      flex-shrink: 0; width: 144px; background: #fff; border: 1px solid var(--border);
      border-radius: 16px; padding: 10px; text-align: center;
    }
    .pro-avatar {
      width: 52px; height: 52px; border-radius: 50%; object-fit: cover;
      border: 2px solid var(--primary); margin: 0 auto 6px; display: block;
    }

    .card {
      background: #fff; border: 1px solid var(--border);
      border-radius: 15px; padding: 13px; margin-bottom: 10px;
    }
    label { display: block; font-size: 11.5px; font-weight: 700; color: #334155; margin: 9px 0 4px; }
    input, select, textarea {
      width: 100%; padding: 9px 11px; border: 1.5px solid var(--border);
      border-radius: 10px; font-size: 13.5px; background: #f8fafc; color: var(--dark); outline: none;
    }
    input:focus, select:focus, textarea:focus { border-color: var(--primary); background: #fff; }
    textarea { min-height: 54px; resize: vertical; }

    .btn {
      width: 100%; border: none; padding: 11px 12px; border-radius: 12px;
      font-size: 12.5px; font-weight: 800; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 5px;
      text-decoration: none;
    }
    .btn-primary { background: linear-gradient(135deg,#10b981,#059669); color: #fff; }
    .btn-dark { background: var(--dark); color: #fff; }
    .btn-outline { background: #fff; color: var(--primary); border: 1.5px solid var(--primary); }
    .btn-danger { background: #fee2e2; color: var(--danger); }
    .btn-warn { background: #fef3c7; color: #92400e; }
    .btn-sm { padding: 7px 10px; font-size: 11px; border-radius: 9px; }

    .subtabs { display: flex; gap: 6px; margin-bottom: 12px; background: #e2e8f0; padding: 4px; border-radius: 12px; }
    .subtab {
      flex: 1; border: none; background: transparent; padding: 7px 4px;
      border-radius: 9px; font-size: 11.5px; font-weight: 800; color: #475569; cursor: pointer;
    }
    .subtab.active { background: #fff; color: var(--primary); }

    .radar-box { background: linear-gradient(135deg,#064e3b,#0f172a); border-radius: 12px; padding: 10px 12px; color: #fff; margin: 8px 0; }
    .radar-track { height: 4px; background: rgba(255,255,255,0.2); border-radius: 4px; margin: 10px 0 4px; position: relative; }
    .radar-fill { height: 100%; width: 65%; background: #34d399; border-radius: 4px; }
    .radar-pin { position: absolute; top: -11px; left: 62%; font-size: 16px; animation: movePin 2.2s ease-in-out infinite alternate; }
    @keyframes movePin { from { left: 45%; } to { left: 78%; } }

    .stepper { display: flex; justify-content: space-between; margin: 10px 0 6px; position: relative; }
    .stepper::before { content: ""; position: absolute; top: 10px; left: 8%; right: 8%; height: 2px; background: #e2e8f0; }
    .step-item { position: relative; z-index: 1; text-align: center; flex: 1; }
    .step-dot {
      width: 20px; height: 20px; border-radius: 50%; margin: 0 auto 3px;
      background: #e2e8f0; color: #64748b; font-size: 10px; font-weight: 800;
      display: flex; align-items: center; justify-content: center;
    }
    .step-item.done .step-dot { background: var(--primary); color: #fff; }
    .step-lbl { font-size: 9px; font-weight: 700; color: var(--muted); }
    .step-item.done .step-lbl { color: var(--primary); }

    .pill { font-size: 9.5px; font-weight: 800; padding: 3px 8px; border-radius: 12px; text-transform: uppercase; }
    .pill-pending { background: #fef3c7; color: #92400e; }
    .pill-accepted { background: #dbeafe; color: #1e40af; }
    .pill-in_progress { background: #ede9fe; color: #5b21b6; }
    .pill-completed { background: #d1fae5; color: #065f46; }
    .pill-urgent { background: #fee2e2; color: #dc2626; }

    .wallet-hero { background: linear-gradient(135deg,#0f172a,#1e293b); color: #fff; border-radius: 16px; padding: 14px; margin-bottom: 12px; }
    .wallet-bal { font-size: 24px; font-weight: 900; color: #34d399; }

    .kpi-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; margin-bottom: 12px; }
    .kpi-card { background: #fff; border: 1px solid var(--border); border-radius: 13px; padding: 11px; }
    .kpi-val { font-size: 17px; font-weight: 900; color: var(--primary); }
    .kpi-lbl { font-size: 10.5px; color: var(--muted); font-weight: 700; }

    .heat-row { margin-bottom: 8px; }
    .heat-track { height: 8px; background: #e2e8f0; border-radius: 6px; overflow: hidden; margin-top: 3px; }
    .heat-fill { height: 100%; background: linear-gradient(90deg, #10b981, #f59e0b); border-radius: 6px; }

    .chat-box {
      max-height: 220px; overflow-y: auto; background: #f8fafc; border: 1px solid var(--border);
      border-radius: 12px; padding: 10px; margin-bottom: 8px; display: flex; flex-direction: column; gap: 6px;
    }
    .chat-msg { max-width: 82%; padding: 7px 10px; border-radius: 12px; font-size: 12px; line-height: 1.4; }
    .chat-me { align-self: flex-end; background: var(--primary); color: #fff; border-bottom-right-radius: 3px; }
    .chat-them { align-self: flex-start; background: #fff; border: 1px solid var(--border); color: var(--dark); border-bottom-left-radius: 3px; }

    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0; margin: 0 auto;
      width: 100%; max-width: 440px;
      background: #ffffff; border-top: 1px solid var(--border);
      display: flex; z-index: 40;
      padding-bottom: env(safe-area-inset-bottom);
    }
    .nav-item {
      flex: 1; border: none; background: none; padding: 8px 4px 10px;
      font-size: 10.5px; font-weight: 700; color: var(--muted); cursor: pointer;
      display: flex; flex-direction: column; align-items: center; gap: 2px;
    }
    .nav-item.active { color: var(--primary); }
    .nav-ico { font-size: 18px; }

    .overlay {
      position: fixed; inset: 0; background: rgba(15,23,42,0.62);
      z-index: 80; display: flex; align-items: flex-end; justify-content: center;
    }
    .overlay.center { align-items: center; padding: 14px; }
    .overlay.hidden { display: none; }
    .sheet {
      width: 100%; max-width: 440px; max-height: 92vh; overflow-y: auto;
      background: #fff; border-top-left-radius: 24px; border-top-right-radius: 24px; padding: 16px 16px 24px;
    }
    .modal-box {
      width: 100%; max-width: 395px; max-height: 88vh; overflow-y: auto;
      background: #fff; border-radius: 20px; padding: 16px;
    }
    .slot-row { display: flex; gap: 6px; margin-top: 5px; }
    .slot-chip {
      flex: 1; text-align: center; padding: 7px 4px; border-radius: 10px;
      border: 1.5px solid var(--border); font-size: 11px; font-weight: 700; cursor: pointer; background: #f8fafc;
    }
    .slot-chip.active { border-color: var(--primary); background: var(--primary-light); color: var(--primary-dark); }

    .rate-box { background: #f8fafc; border: 1px solid var(--border); border-radius: 12px; padding: 9px; margin-bottom: 8px; }
    .rate-row { display: flex; justify-content: space-between; font-size: 11px; padding: 3px 0; border-bottom: 1px dashed #e2e8f0; }
    .rate-row:last-child { border-bottom: none; }
    .otp-box {
      background: #fef3c7; border: 1.5px dashed #d97706; border-radius: 10px;
      padding: 6px 10px; margin-top: 7px; display: flex; justify-content: space-between; align-items: center;
    }
    .warranty-cert { border: 2px solid #059669; border-radius: 16px; padding: 16px; background: #ecfdf5; text-align: center; }

    .toast {
      position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
      background: var(--dark); color: #fff; padding: 9px 14px; border-radius: 12px;
      font-size: 12px; font-weight: 700; z-index: 120; max-width: 90%; text-align: center;
    }
    .hidden { display: none !important; }
    .meta { font-size: 11.5px; color: #475569; line-height: 1.45; }

    @media print {
      body { background: #fff !important; }
      .phone-shell, .bottom-nav, .toast { display: none !important; }
      #warrantyModal { position: static !important; display: block !important; background: #fff !important; padding: 0 !important; }
      #warrantyModal .modal-box { max-width: 100% !important; max-height: none !important; box-shadow: none !important; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>

<div class="phone-shell">
  <div id="toast" class="toast hidden"></div>

  <!-- TAB 1: HOME -->
  <div id="view-home">
    <div class="hero">
      <div class="topbar">
        <div class="brand-wrap" onclick="onLogoTap()" title="3x Tap for Staff Access">
          <div class="brand-logo">🛠️</div>
          <div>
            <span class="brand-name" id="hdrBrand">KaamWala</span>
            <span class="brand-tag" id="tSubTag">12+ Verified Home Skills</span>
          </div>
        </div>
        <div class="top-actions">
          <button class="pill-btn" onclick="toggleLang()" id="langBtn">اردو</button>
          <button class="pill-btn" onclick="onCityTap()" id="hdrCityBtn">📍 Lahore</button>
          <button class="icon-btn" id="hdrSettingsBtn" onclick="openProtected('settings')" title="Staff Settings">⚙️</button>
        </div>
      </div>

      <div class="hero-title" id="tHeroTitle">Har Hunar aur Kaam ke liye Verified Ustad — 45 Min mein!</div>
      <div class="hero-stats">
        <span class="hero-stat">★ 4.9 Avg Rating</span>
        <span class="hero-stat">🛠️ 12+ Hunar</span>
        <span class="hero-stat">🛡️ 7-Day Warranty</span>
      </div>

      <div class="search-box">
        <span>🤖</span>
        <input type="text" id="searchInput" placeholder="Search: 'solar', 'AC E1', 'salon', 'door lock', 'bike'..." oninput="onSmartSearch()" />
      </div>
    </div>

    <div id="aiFaultBox" class="ai-box hidden"></div>

    <div class="reminder-bar">
      <div style="font-size:11px; color:#92400e;">
        <strong id="tRemTitle">🔄 90-Day AC & Solar Check Due!</strong><br>
        <span id="tRemDesc">15% OFF par seasonal service book karein</span>
      </div>
      <button onclick="openBookingSheet('solar')" class="btn btn-warn btn-sm" style="width:auto; border:1px solid #f59e0b;" id="tRemBtn">Book Solar</button>
    </div>

    <div class="promo-strip">
      <div>
        <div style="font-size:12px; font-weight:800;" id="tPromoTitle">Pehle Order par Rs. 200 OFF! 🎉</div>
        <div style="font-size:10.5px; opacity:0.9;">
          <span id="tCreditPrefix">Referral Credit:</span> <strong id="custCreditLbl">Rs. 0</strong>
        </div>
      </div>
      <div class="promo-code" onclick="copyCode('FIRST200')">FIRST200</div>
    </div>

    <div class="cat-row" id="catRow">
      <div class="cat-chip active" data-cat="all" onclick="setCat('all')" id="catAll">✨ All (12)</div>
      <div class="cat-chip" data-cat="repair" onclick="setCat('repair')" id="catRepair">🔧 Repairs</div>
      <div class="cat-chip" data-cat="build" onclick="setCat('build')" id="catBuild">☀️ Solar & Wood</div>
      <div class="cat-chip" data-cat="female" onclick="setCat('female')" id="catFemale">👩 Salon & Care</div>
      <div class="cat-chip" data-cat="auto" onclick="setCat('auto')" id="catAuto">🚗 Auto & Errands</div>
      <div class="cat-chip" id="femaleFilterChip" onclick="toggleFemaleMode()">🛡️ Family-Safe Only</div>
    </div>

    <div class="section">
      <div class="sec-head">
        <div class="sec-title" id="tSecServices">Services & Hunar</div>
        <div class="sec-link" onclick="openBookingSheet('ac')" id="tQuickBook">Quick Book →</div>
      </div>
      <div class="services-grid" id="servicesGrid"></div>
    </div>

    <div class="section">
      <div class="dual-grid">
        <div class="action-tile" style="background:linear-gradient(135deg,#1e3a8a,#2563eb);" onclick="openBigJobModal()">
          <div style="font-size:20px;">🔨</div>
          <div>
            <div style="font-size:12.5px; font-weight:800;" id="tBigJobTitle">Post Big Job (Bids)</div>
            <div style="font-size:10px; opacity:0.88;" id="tBigJobDesc">Solar, Paint, Wood — 3 quotes payein</div>
          </div>
        </div>
        <div class="action-tile" style="background:linear-gradient(135deg,#0f172a,#334155);" onclick="openB2BModal()">
          <div style="font-size:20px;">🏢</div>
          <div>
            <div style="font-size:12.5px; font-weight:800;" id="tB2bTitle">B2B Office / Shop</div>
            <div style="font-size:10px; opacity:0.88;" id="tB2bDesc">Clinics, Cafes & Societies contracts</div>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="sec-head">
        <div class="sec-title" id="tSecPlans">Monthly Care Plans 💎</div>
        <div class="sec-link">Save 35%</div>
      </div>
      <div class="h-scroll" id="plansRow"></div>
    </div>

    <div class="section">
      <div class="card" style="background:linear-gradient(135deg,#ecfdf5,#fff); border-color:#a7f3d0;">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px;">
          <div>
            <div style="font-size:13px; font-weight:800; color:#065f46;" id="tRefTitle">🎁 Refer & Earn Rs. 200</div>
            <div class="meta" style="font-size:11px;" id="tRefDesc">Doston ko invite karein, dono ko Rs. 200 credit milega!</div>
          </div>
          <button onclick="copyCode('REF200')" class="btn btn-primary btn-sm" style="width:auto;">Share</button>
        </div>
        <button id="demoRefBtn" onclick="simulateReferralBonus()" class="btn btn-outline btn-sm" style="margin-top:8px;">+ Test Friend Joined (+Rs. 200 Credit)</button>
      </div>
    </div>

    <div class="section">
      <div class="sec-head">
        <div class="sec-title" id="tSecPros">Top Hunarmand Pros</div>
        <div class="sec-link" id="proCountLbl">Verified</div>
      </div>
      <div class="h-scroll" id="prosRow"></div>
    </div>
  </div>

  <!-- TAB 2: MY ORDERS -->
  <div id="view-orders" class="hidden">
    <div class="hero" style="padding-bottom:14px;">
      <div class="topbar" style="margin-bottom:4px;">
        <div class="brand-name" id="tOrdersHdr">📦 Meri Bookings</div>
        <button class="pill-btn" onclick="switchView('home')">+ New Order</button>
      </div>
      <div class="hero-stats" style="margin-bottom:0;">
        <span class="hero-stat" id="tOrdersSub">Live Radar, In-App Chat, Custom Bids & Warranty Cards</span>
      </div>
    </div>
    <div class="section">
